# MCP Auth – Azure AD (RS256 JWKS, preferred for production)
# Set AZURE_AD_REQUIRE_AUTH=true to enable Azure AD token validation
AZURE_AD_REQUIRE_AUTH=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=

# MCP Auth – Symmetric key (HS256 fallback, used when Azure AD auth is not enabled)
MCP_AUTH_SECRET=your-secret-key-minimum-32-characters
MCP_AUTH_ISSUER=mcp-issuer
MCP_AUTH_AUDIENCE=azure-ai-search-mcp

# Azure AI Search
SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
SEARCH_INDEX_NAME=your-index-name
SEARCH_INDEXER_NAME=your-indexer-name

# Azure Blob Storage (required for returning images from search results)
STORAGE_ACCOUNT_BLOB_ENDPOINT=https://your-storage-account.blob.core.windows.net
STORAGE_ACCOUNT_CONTAINER_NAME=your-container-name

# Azure cloud (leave blank for public cloud, set to "AzureUSGovernment" for gov)
CLOUD_NAME=
